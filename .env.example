# ------------------------------------------------------------------
# Configuração do aplicativo (frontend). Copie para ".env" e preencha.
# Os valores VITE_ são públicos por natureza (a proteção é feita por
# RLS no Supabase) e também devem ser cadastrados como secrets no
# repositório do GitHub: VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY.
# ------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANONIMA_PUBLICA

# ------------------------------------------------------------------
# Somente para o comando de importação via linha de comando
# (npm run importar). NUNCA comite a service role key.
# ------------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Conexão administrativa usada somente pelos scripts locais. Nunca use VITE_.
DATABASE_URL=
